# Backend settings for AIBIZTECH's own Stock Manager (copy to backend/.env on the VPS; never commit the real file).
# Its own, empty data: the "stock" schema of the portal database. Nothing here touches the old Stock Manager.
DB_BACKEND=postgres
# Portal Supabase -> Connect -> Session pooler URI, with the database password filled in (URL-encode special characters)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Keep this app's tables in the "stock" schema ("extensions" is where Supabase keeps the citext type)
PG_SCHEMA=stock,extensions
JWT_SECRET=<run: openssl rand -hex 32>
# The same value as SSO_SECRET in the portal's Vercel project
SSO_SECRET=<run: openssl rand -hex 32>
FRONTEND_URL=https://<new-stock-address>
CORS_ORIGINS=https://<new-stock-address>
