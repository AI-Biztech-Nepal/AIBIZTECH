NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Parent domain for the shared session cookie, e.g. .aibiztechnepal.com. Leave empty on localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=
# Links to your published Terms of Service and Privacy Policy. The sign-up page shows them once both are set.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# Where "subscribe" and "contact sales" lead: an email address, phone number or web address.
NEXT_PUBLIC_SALES_CONTACT=
# One login for other apps: a random secret of 32+ characters, the same value in that app's server settings,
# and the apps that accept it (comma separated, for example "stock").
SSO_SECRET=
SSO_SERVICES=
# 1 = "Stock Manager" opens the live Auto Stock Manager inside the portal (needs SSO above); empty = the pages under /stock.
STOCK_LIVE_APP=
STOCK_LIVE_URL=
