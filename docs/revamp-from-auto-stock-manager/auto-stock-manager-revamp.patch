+
+@api_router.get("/business-profile")
+async def get_business_profile(cu: dict = Depends(get_current_user)):
+    # Readable by every role: the nav hides modules the company has not switched on.
+    # No profile at all = a company that existed before the builder: nothing is hidden.
+    s = await db.settings.find_one({}, {"_id": 0, "business_profile": 1}) or {}
+    return s.get("business_profile") or {"onboarded": True, "legacy": True}
+
+@api_router.put("/business-profile")
+async def put_business_profile(p: BusinessProfile, cu: dict = Depends(admin_only)):
+    prof = {**p.model_dump(), "onboarded": True, "completed_at": datetime.now(timezone.utc).isoformat()}
+    await db.settings.update_one({}, {"$set": {"business_profile": prof}}, upsert=True)
+    return prof
+
